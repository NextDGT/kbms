{
  "name": "kbms",
  "version": "0.1.1",
  "description": "KBMS — Kurumsal Belge Maskeleme Sistemi",
  "main": "out/main/index.js",
  "author": "KBMS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/smoke-dicts.mjs",
    "test": "node tests/run.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.8.15",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^35.0.3",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.0.0",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "com.kbms.app",
    "productName": "KBMS",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/dicts",
        "to": "dicts"
      },
      {
        "from": "resources/tessdata",
        "to": "tessdata"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/pdfjs-dist/**/*",
      "**/node_modules/@napi-rs/**/*",
      "**/node_modules/tesseract.js/**/*",
      "**/node_modules/tesseract.js-core/**/*",
      "**/node_modules/regenerator-runtime/**/*",
      "**/node_modules/is-url/**/*",
      "**/node_modules/bmp-js/**/*",
      "**/node_modules/zlibjs/**/*",
      "**/node_modules/wasm-feature-detect/**/*",
      "**/node_modules/idb-keyval/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "KBMS <dev@kbms.local>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
